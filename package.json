{
  "name": "school-coupon",
  "version": "1.0.0",
  "private": true,
  "description": "School Coupon backend foundation",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:admin": "next build apps/admin",
    "dev:admin": "next dev apps/admin -p 3001",
    "start:admin": "next start apps/admin -p 3001",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"apps/admin/app/**/*.{ts,tsx}\" \"apps/admin/next.config.ts\"",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\" \"apps/admin/app/**/*.{ts,tsx}\" \"apps/admin/next.config.ts\"",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:integration": "jest --runInBand --testPathPattern=integration",
    "simulate": "tsx scripts/simulate-school-day.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.5.0",
    "jsonwebtoken": "^9.0.2",
    "next": "^16.4.5",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@embedded-postgres/windows-x64": "17.11.0-beta.19",
    "@types/express": "^5.0.6",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "jose": "^6.2.15",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "supertest": "^7.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "multer": "^2.5.0"
  }
}
