            <mxPoint x="850" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2_10" value="10. ตรวจว่ายังไม่ข้ามวัน (ก่อน 23:59:59 น.) + คืนเงินเข้าบัตร" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
