        <mxCell id="m3_1" value="1. สั่งออกบัตรใหม่ (รหัสนักเรียน, รหัสบัตร RFID ใหม่)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
