        <mxCell id="p3_cron" value="ตัวตั้งเวลาอัตโนมัติ&#xa;(งานรอบเที่ยงคืน)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};fillColor=#ede9fe;strokeColor=#7c3aed;fontStyle=1;size=50;" vertex="1" parent="1">
