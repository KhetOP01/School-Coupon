        </mxCell>
        <mxCell id="p1_nginx" value="ตัวกระจายทราฟฟิก&#xa;(Nginx พอร์ต 80)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};fillColor=#e0f2fe;strokeColor=#0284c7;fontStyle=1;size=50;" vertex="1" parent="1">
          <mxGeometry x="290" y="70" width="140" height="680" as="geometry" />
        </mxCell>
        <mxCell id="p1_api" value="ระบบหลังบ้าน API&#xa;(โมดูลบัญชีนักเรียน)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;size=50;" vertex="1" parent="1">
          <mxGeometry x="530" y="70" width="150" height="680" as="geometry" />
        </mxCell>
        <mxCell id="p1_gw" value="ระบบรับชำระเงิน&#xa;(Omise / จำลอง)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;size=50;" vertex="1" parent="1">
          <mxGeometry x="780" y="70" width="160" height="680" as="geometry" />
        </mxCell>
        <mxCell id="p1_db" value="ฐานข้อมูล PostgreSQL&#xa;(กระเป๋าเงินและประวัติเติม)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};fillColor=#f1f5f9;strokeColor=#475569;fontStyle=1;size=50;" vertex="1" parent="1">
          <mxGeometry x="1040" y="70" width="160" height="680" as="geometry" />
        </mxCell>

        <!-- Messages -->
        <mxCell id="m1_1" value="1. ส่งคำขอเติมเงิน (รหัสนักเรียน, จำนวน 50-2,000 บาท)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="160" as="sourcePoint" />
            <mxPoint x="360" y="160" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1_2" value="2. ส่งต่อคำขอไปยัง API" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="195" as="sourcePoint" />
            <mxPoint x="605" y="195" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1_3" value="3. ตรวจวงเงินเติม (50-2,000 บ.) และยอดสะสมไม่เกิน 5,000 บ." style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="605" y="235" as="sourcePoint" />
            <mxPoint x="1120" y="235" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1_4" value="4. สั่งสร้างคิวอาร์พร้อมเพย์" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="605" y="275" as="sourcePoint" />
            <mxPoint x="860" y="275" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1_5" value="5. ส่งกลับลิงก์รูปคิวอาร์และรหัสอ้างอิง" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="315" as="sourcePoint" />
            <mxPoint x="605" y="315" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1_6" value="6. บันทึกรายการเติมเงิน (สถานะ: รอชำระเงิน)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="605" y="355" as="sourcePoint" />
            <mxPoint x="1120" y="355" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1_7" value="7. แสดงรูปคิวอาร์บนหน้าจอมือถือ (เริ่มตรวจสอบสถานะอัตโนมัติ)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="605" y="395" as="sourcePoint" />
            <mxPoint x="130" y="395" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Webhook Block -->
        <mxCell id="f1_webhook" value="เมื่อผู้ปกครองสแกนจ่ายเงินสำเร็จ (แจ้งผลอัตโนมัติ)" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fillColor=none;strokeColor=#64748b;width=310;height=25;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="425" width="1080" height="285" as="geometry" />
        </mxCell>
        <mxCell id="m1_8" value="8. ส่งสัญญาณแจ้งชำระเงินสำเร็จ (Webhook)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="860" y="475" as="sourcePoint" />
            <mxPoint x="360" y="475" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1_9" value="9. ส่งต่อข้อมูลแจ้งผลชำระเงิน" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="360" y="515" as="sourcePoint" />
            <mxPoint x="605" y="515" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1_10" value="10. อัปเดตสถานะสำเร็จ + เพิ่มยอดเงินและบันทึกบัญชี" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="605" y="555" as="sourcePoint" />
            <mxPoint x="1120" y="555" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1_11" value="11. ตอบรับการแจ้งผลสำเร็จ" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="605" y="595" as="sourcePoint" />
            <mxPoint x="860" y="595" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1_12" value="12. แอปผู้ปกครองสอบถามสถานะการเติมเงิน" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="130" y="635" as="sourcePoint" />
            <mxPoint x="605" y="635" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m1_13" value="13. แสดงข้อความเติมเงินสำเร็จ พร้อมยอดเงินล่าสุด" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="605" y="675" as="sourcePoint" />
            <mxPoint x="130" y="675" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="uc05-06-pos-th" name="2. UC-05 &amp; UC-06 ชำระเงินร้านค้า &amp; ยกเลิกบิล">
    <mxGraphModel dx="1400" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="860" math="0" shadow="0">
