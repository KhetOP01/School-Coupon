        <mxCell id="p2_local" value="หน่วยความจำเครื่อง&#xa;(คิวรายการออฟไลน์)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;size=50;" vertex="1" parent="1">
          <mxGeometry x="300" y="70" width="160" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p2_nginx" value="ตัวกระจายทราฟฟิก&#xa;(Nginx พอร์ต 80)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};fillColor=#e0f2fe;strokeColor=#0284c7;fontStyle=1;size=50;" vertex="1" parent="1">
          <mxGeometry x="540" y="70" width="140" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p2_api" value="ระบบหลังบ้าน API&#xa;(โมดูลการชำระเงิน)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};fillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;size=50;" vertex="1" parent="1">
          <mxGeometry x="770" y="70" width="160" height="720" as="geometry" />
        </mxCell>
        <mxCell id="p2_db" value="ฐานข้อมูล PostgreSQL&#xa;(รายการขายและบัญชี)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;curved&quot;:0,&quot;rounded&quot;:0};fillColor=#f1f5f9;strokeColor=#475569;fontStyle=1;size=50;" vertex="1" parent="1">
          <mxGeometry x="1030" y="70" width="160" height="720" as="geometry" />
        </mxCell>

        <!-- Alt Online / Offline -->
        <mxCell id="f2_alt" value="ทางเลือก [โหมดออนไลน์ vs โหมดออฟไลน์]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fillColor=none;strokeColor=#64748b;width=260;height=25;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="140" width="1130" height="410" as="geometry" />
        </mxCell>

        <mxCell id="m2_1" value="1. [ออนไลน์] แตะบัตร RFID ส่งยอดชำระเงิน" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="195" as="sourcePoint" />
            <mxPoint x="610" y="195" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2_2" value="2. ส่งต่อคำขอชำระเงินไปยัง API" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="610" y="230" as="sourcePoint" />
            <mxPoint x="850" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2_3" value="3. ตรวจสถานะบัตร วงเงินรายวัน และยอดเงินคงเหลือ" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="850" y="270" as="sourcePoint" />
            <mxPoint x="1110" y="270" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2_4" value="4. ตัดยอดเงิน + บันทึกบิลและบัญชี (ชำระเงินสำเร็จ)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1110" y="310" as="sourcePoint" />
            <mxPoint x="140" y="310" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Divider -->
        <mxCell id="f2_div" value="" style="line;strokeWidth=1;dashed=1;html=1;strokeColor=#94a3b8;" vertex="1" parent="1">
          <mxGeometry x="50" y="340" width="1130" height="10" as="geometry" />
        </mxCell>

        <mxCell id="m2_5" value="5. [ออฟไลน์] บันทึกลงคิวในเครื่อง (&lt;= 100 บ./ครั้ง, ไม่เกิน 12 ชม.)" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="140" y="390" as="sourcePoint" />
            <mxPoint x="380" y="390" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2_6" value="6. เมื่อเน็ตกลับมา: กดซิงก์รายการออฟไลน์ขึ้นเซิร์ฟเวอร์" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="380" y="435" as="sourcePoint" />
            <mxPoint x="850" y="435" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2_7" value="7. ตรวจรายการซ้ำ (อนุญาตติดลบถึง -500 บ.) + บันทึกฐานข้อมูล" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="850" y="475" as="sourcePoint" />
            <mxPoint x="1110" y="475" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m2_8" value="8. ยืนยันซิงก์สำเร็จ -> ลบรายการออกจากคิวในเครื่อง" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="850" y="515" as="sourcePoint" />
            <mxPoint x="140" y="515" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- UC-06 Void -->
        <mxCell id="f2_void" value="กรณีเพิ่มเติม [UC-06: ยกเลิกบิลภายในวันเดียวกัน]" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fillColor=none;strokeColor=#64748b;width=310;height=25;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="575" width="1130" height="175" as="geometry" />
        </mxCell>
        <mxCell id="m2_9" value="9. กดยกเลิกบิลตามรหัสอ้างอิง" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
