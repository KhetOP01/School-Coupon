        <!-- UC-01 -->
        <mxCell id="f3_reissue" value="UC-01: ออกบัตร RFID ใหม่แทนบัตรหาย" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;fillColor=none;strokeColor=#64748b;width=250;height=25;fontStyle=1;" vertex="1" parent="1">
