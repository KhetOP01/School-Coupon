        <mxCell id="m2_11" value="11. แจ้งยกเลิกบิลสำเร็จ (สถานะ: ยกเลิกแล้ว)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;curved=0;rounded=0;fontSize=12;" edge="1" parent="1">
