            <mxPoint x="850" y="710" as="sourcePoint" />
            <mxPoint x="140" y="710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="uc01-07-admin-th" name="3. UC-01 ออกบัตรใหม่ &amp; UC-07 สรุปยอดโอน">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="760" math="0" shadow="0">
      <root>
